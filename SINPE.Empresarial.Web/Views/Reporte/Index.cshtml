@model IEnumerable<SINPE.Empresarial.Domain.ReporteDomain.Entities.ReporteMensual>

@{
    ViewBag.Title = "Reportes Mensuales";
}

<!-- SweetAlert para mensajes futuros -->
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<main>

    <!-- Título de la página -->
    <h1 class="mb-4"> Reportes Mensuales </h1>

    <!-- Barra de Opciones -->
    <div class="fixed-table-toolbar d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">

        <!-- Botón para generar reportes -->
        <form method="post" action="@Url.Action("Generar", "Reporte")" style="margin: 0;">
            <button type="submit" class="btn text-white fw-bold" style="background-color: #574FD6;">
                <i class="bi bi-file-earmark-bar-graph"></i> Generar/Actualizar Reportes
            </button>
        </form>

        <!-- Opciones futuras (buscador, refrescar) -->
        <div class="d-flex align-items-center gap-2">
            <input class="form-control" type="search" placeholder="Buscar reporte" style="display: none;">
            <button class="btn btn-secondary" style="display: none;">
                <i class="bi bi-arrow-clockwise"></i>
            </button>
        </div>
    </div>

    <!-- Tabla de reportes -->
    <div class="table-responsive mb-5">
        <table class="table table-hover align-middle">
            <!-- Encabezado -->
            <thead class="table-light">
                <tr>
                    <th>Acciones</th>
                    <th>Comercio</th>
                    <th>Cajas Activas</th>
                    <th>SINPEs Mes</th>
                    <th>Monto Recaudado</th>
                    <th>Comisión</th>
                    <th>Fecha del Reporte</th>
                </tr>
            </thead>

            <!-- Registros -->
            <tbody class="table-group-divider">
                @foreach (var r in Model)
                {
                    <tr>
                        <td>
                            <!-- Por ahora solo detalles, se podrían agregar más opciones -->
                            <a href="@Url.Action("Detalles", "Comercio", new { id = r.IdComercio })"
                               class="btn btn-sm btn-primary">
                                <i class="bi bi-eye-fill"></i>
                            </a>
                        </td>
                        <td>@r.Comercio.Nombre</td>
                        <td>@r.CantidadDeCajas</td>
                        <td>@r.CantidadDeSINPES</td>
                        <td>@r.MontoTotalRecaudado.ToString("C")</td>
                        <td>@r.MontoTotalComision.ToString("C")</td>
                        <td>@r.FechaDelReporte.ToString("dd/MM/yyyy")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

</main>
