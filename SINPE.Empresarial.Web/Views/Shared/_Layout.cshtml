@using Microsoft.AspNet.Identity
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>@ViewBag.Title - SINPE Empresarial</title>
    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/Content/css/SharedStyles/layout.css" />
</head>
<body>

    <nav class="navbar navbar-expand-lg navbar-light main-navbar">
        <div class="container">

            @Html.ActionLink("SINPE Empresarial", "Index", "Home", new { area = "" }, new { @class = "navbar-brand fw-semibold main-logo" })

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar"
                    aria-controls="mainNavbar" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="mainNavbar">

                <!-- IZQUIERDA: navegación de la app -->
                <ul class="navbar-nav me-auto">
                    <li class="nav-item">
                        @Html.ActionLink("Inicio", "Index", "Home", new { area = "" }, new { @class = "nav-link main-link" })
                    </li>

                    @if (Request.IsAuthenticated && User.IsInRole("Administrador"))
                    {
                        <li class="nav-item">@Html.ActionLink("Comercio", "Index", "Comercio", new { area = "" }, new { @class = "nav-link main-link" })</li>
                        <li class="nav-item">@Html.ActionLink("Caja", "SeleccionComercio", "Caja", new { area = "" }, new { @class = "nav-link main-link" })</li>
                        <li class="nav-item">@Html.ActionLink("Sinpe", "Register", "Sinpe", new { area = "" }, new { @class = "nav-link main-link" })</li>
                        <li class="nav-item">@Html.ActionLink("Reportes", "Index", "Reporte", new { area = "" }, new { @class = "nav-link main-link" })</li>

                        <!-- Dropdown Admin de sistema -->
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle main-link" href="#" id="adminDropdown" role="button"
                               data-bs-toggle="dropdown" aria-expanded="false">
                                Administrador de sistema
                            </a>
                            <ul class="dropdown-menu shadow-sm" aria-labelledby="adminDropdown">
                                <li>@Html.ActionLink("Bitácora", "Index", "Bitacora", new { area = "" }, new { @class = "dropdown-item" })</li>
                                <li><hr class="dropdown-divider" /></li>
                                <li>@Html.ActionLink("Usuarios", "Index", "Usuario", new { area = "" }, new { @class = "dropdown-item" })</li>
                                <li>@Html.ActionLink("Configuración", "Index", "Configuracion", new { area = "" }, new { @class = "dropdown-item" })</li>
                            </ul>
                        </li>
                    }

                    @if (Request.IsAuthenticated && User.IsInRole("Cajero"))
                    {
                        <li class="nav-item">@Html.ActionLink("Caja", "SeleccionComercio", "Caja", new { area = "" }, new { @class = "nav-link main-link" })</li>
                    }
                </ul>

                <!-- DERECHA: login / logout -->
                <ul class="navbar-nav ms-auto">
                    @Html.Partial("_LoginPartial")
                </ul>
            </div>
        </div>
    </nav>

    <div class="container body-content">
        @RenderBody()

        <footer class="foot-footer text-center py-4">
            <p class="mb-1 fw-semibold">SINPE Empresarial © @DateTime.Now.Year</p>
            <p class="small text-muted mb-2">Desarrollado por <strong>Grupo C</strong> - Universidad Fidélitas</p>

            <div class="footer-links mb-2">
                <a href="@Url.Action("About", "Home")">Sobre nosotros</a> ·
                <a href="@Url.Action("Contact", "Home")">Contacto</a> ·
            </div>

            <div>
                <a href="#" class="foot-social"><i class="bi bi-facebook"></i></a>
                <a href="#" class="foot-social"><i class="bi bi-linkedin"></i></a>
                <a href="#" class="foot-social"><i class="bi bi-github"></i></a>
            </div>
        </footer>
    </div>

    @Scripts.Render("~/bundles/jquery")
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("scripts", required: false)

</body>
</html>
