@model SINPE.Empresarial.Web.Auth.RegisterViewModel
@{
    ViewBag.Title = "Registro";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2 class="mb-3">Crear cuenta</h2>

@using (Html.BeginForm("Register", "Account", FormMethod.Post, new { @class = "needs-validation" }))
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })

    <div class="mb-3">
        @Html.LabelFor(m => m.Email, new { @class = "form-label" })
        @Html.TextBoxFor(m => m.Email, new { @class = "form-control", placeholder = "correo@dominio.com" })
        @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger" })
    </div>

    <div class="row">
        <div class="col-md-6 mb-3">
            @Html.LabelFor(m => m.Password, new { @class = "form-label" })
            @Html.PasswordFor(m => m.Password, new { @class = "form-control", placeholder = "Mínimo 6 caracteres" })
            @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger" })
        </div>
        <div class="col-md-6 mb-3">
            @Html.LabelFor(m => m.ConfirmPassword, new { @class = "form-label" })
            @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "form-control", placeholder = "Repite la contraseña" })
            @Html.ValidationMessageFor(m => m.ConfirmPassword, "", new { @class = "text-danger" })
        </div>
    </div>

    <div class="mb-3">
        @Html.LabelFor(m => m.Rol, new { @class = "form-label" })
        @Html.DropDownListFor(m => m.Rol,
            (SelectList)ViewBag.Roles,
            "Seleccione…",
            new { @class = "form-select" })
        @Html.ValidationMessageFor(m => m.Rol, "", new { @class = "text-danger" })
    </div>

    <button type="submit" class="btn btn-success">Registrar</button>
    <a class="btn btn-link" href="@Url.Action("Login","Account")">¿Ya tienes cuenta? Inicia sesión</a>
}

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
