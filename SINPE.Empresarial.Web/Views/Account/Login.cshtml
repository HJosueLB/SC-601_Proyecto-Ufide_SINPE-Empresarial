@model SINPE.Empresarial.Web.Auth.LoginViewModel
@{
    Layout = null; // SIN LAYOUT
    ViewBag.Title = "Iniciar sesión";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>@ViewBag.Title</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <link rel="stylesheet" href="~/Content/css/LoginStyles/login.css" />
</head>
<body>
    <div class="page">
        <div class="card" role="form" aria-labelledby="t">
            <div class="brand">
                <h1 id="t">Iniciar sesión</h1>
                <p class="sub">Accede a tu cuenta</p>
            </div>

            @using (Html.BeginForm("Login", "Account", FormMethod.Post, new { autocomplete = "on" }))
            {
                @Html.AntiForgeryToken()

                <div class="group">
                    @Html.LabelFor(m => m.Email, "Correo electrónico")
                    @Html.TextBoxFor(m => m.Email, new { @class = "input", placeholder = "correo@dominio.com", autocomplete = "email", required = "required", id = "email" })
                    @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger", role = "alert" })
                </div>

                <div class="group">
                    @Html.LabelFor(m => m.Password, "Contraseña")
                    @Html.PasswordFor(m => m.Password, new { @class = "input", placeholder = "••••••••", autocomplete = "current-password", required = "required", id = "password" })
                    @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger", role = "alert" })
                </div>

                <div class="row">
                    <label class="check">
                        @Html.CheckBoxFor(m => m.RememberMe, new { id = "remember" }) Recordarme
                    </label>
                </div>

                <button class="btn" type="submit" id="submitBtn">Entrar</button>
                <p class="hint">¿No tienes cuenta? <a href="@Url.Action("Register","Account")">Regístrate</a></p>
            }
        </div>
    </div>

    <!-- (Opcional) si usas validación cliente por bundles, quítalos si ya están en _Layout -->
    <script>
        (function () {
            const f = document.querySelector('form'), b = document.getElementById('submitBtn');
            f?.addEventListener('submit', function () {
                b.disabled = true; b.textContent = 'Entrando…';
            });
        })();
    </script>
</body>
</html>
