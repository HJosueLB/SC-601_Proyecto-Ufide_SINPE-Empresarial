@model SINPE.Empresarial.Domain.ComercioDomain.Entities.Comercio

@{
    ViewBag.Title = "Registrar Comercio";
}

<!-- Integración de CSS -->
<link rel="stylesheet" href="~/Content/css/ComercioStyles/ComercioRegister.css" />

<!-- Formulario de reigstro de un nuevo comercio -->
<div class="container-fluid bg-light min-vh-100 py-5">
    <div class="container bg-white p-5 shadow-sm rounded-4" style="max-width: 900px;">

        <!-- Encabezado de formulario -->
        <div class="mb-4">
            <h2 class="fw-bold">Registrar Comercio</h2>
            <p class="text-muted mb-0">Completa los datos para registrar un nuevo comercio en el sistema.</p>
        </div>

        <!-- Validación -->
        @using (Html.BeginForm("Register", "Comercio", FormMethod.Post, new { @class = "needs-validation", novalidate = "novalidate" }))
        {
            @Html.AntiForgeryToken()

            <div class="row g-4">

                <!-- Tipo de identificación -->
                <div class="col-md-6">
                    <label for="TipoDeIdentificacionId" class="form-label">Tipo de Identificación</label>
                    @Html.DropDownList("TipoDeIdentificacionId", null, "Seleccione una opción", new { @class = "form-select form-select-lg" })
                    @Html.ValidationMessageFor(m => m.TipoDeIdentificacionId, "", new { @class = "text-danger small" })
                </div>

                <!-- Número de identificación -->
                <div class="col-md-6">
                    <label for="Identificacion" class="form-label">Identificación</label>
                    @Html.TextBoxFor(m => m.Identificacion, new { @class = "form-control form-control-lg", placeholder = "Ej: 1-2345-6789" })
                    @Html.ValidationMessageFor(m => m.Identificacion, "", new { @class = "text-danger small" })
                </div>

                <!-- Nombre del comercio -->
                <div class="col-md-6">
                    <label for="Nombre" class="form-label">Nombre del Comercio</label>
                    @Html.TextBoxFor(m => m.Nombre, new { @class = "form-control form-control-lg", placeholder = "Nombre del comercio" })
                    @Html.ValidationMessageFor(m => m.Nombre, "", new { @class = "text-danger small" })
                </div>

                <!-- Tipo de comercio -->
                <div class="col-md-6">
                    <label for="TipoDeComercioId" class="form-label">Tipo de Comercio</label>
                    @Html.DropDownList("TipoDeComercioId", null, "Seleccione una opción", new { @class = "form-select form-select-lg" })
                    @Html.ValidationMessageFor(m => m.TipoDeComercioId, "", new { @class = "text-danger small" })
                </div>

                <!-- Teléfono -->
                <div class="col-md-6">
                    <label for="Telefono" class="form-label">Teléfono</label>
                    @Html.TextBoxFor(m => m.Telefono, new { @class = "form-control form-control-lg", placeholder = "Teléfono de contacto" })
                    @Html.ValidationMessageFor(m => m.Telefono, "", new { @class = "text-danger small" })
                </div>

                <!-- Correo -->
                <div class="col-md-6">
                    <label for="CorreoElectronico" class="form-label">Correo Electrónico</label>
                    @Html.TextBoxFor(m => m.CorreoElectronico, new { @class = "form-control form-control-lg", placeholder = "Correo electrónico" })
                    @Html.ValidationMessageFor(m => m.CorreoElectronico, "", new { @class = "text-danger small" })
                </div>

                <!-- Dirección -->
                <div class="col-12">
                    <label for="Direccion" class="form-label">Dirección</label>
                    @Html.TextAreaFor(m => m.Direccion, new { @class = "form-control form-control-lg", rows = 2, placeholder = "Dirección física del comercio" })
                    @Html.ValidationMessageFor(m => m.Direccion, "", new { @class = "text-danger small" })
                </div>

                <!-- Botones -->
                <div class="col-12 d-flex justify-content-between flex-wrap gap-3">
                    <button type="submit" class="btn text-white fw-bold" style="background-color: #574FD6;">
                        Registrar
                    </button>

                    <a href="@Url.Action("Index", "Comercio")" class="btn text-white fw-bold" style="background-color: cadetblue;">
                        Regresar
                    </a>
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const ddl = document.getElementById("TipoDeIdentificacionId");
            const ident = document.getElementById("Identificacion");
            const tel = document.getElementById("Telefono"); // si existe en este form

            const digits = s => (s || "").replace(/\D/g, "");
            const blocks = s => (s || "").split("-").map(x => parseInt(x, 10)).filter(Boolean);
            const applyBlocks = (raw, bs) => {
                let out = [], i = 0;
                for (const b of bs) { const chunk = raw.slice(i, i + b); if (!chunk) break; out.push(chunk); i += b; }
                return out.join("-");
            };

            // Ajusta estos IDs si en tu tabla no son 1 y 2:
            const ID_FISICA = 1;
            const ID_JURIDICA = 2;

            const norm = t => (t || "").normalize("NFD").replace(/\p{Diacritic}/gu, "").toUpperCase();

            function formatIdentView() {
                if (!ident) return;
                const raw = digits(ident.value);

                let tipo = null;
                const val = parseInt(ddl?.value || "", 10);
                const txt = ddl?.options[ddl.selectedIndex]?.text || "";

                if (val === ID_FISICA) tipo = "FISICA";
                else if (val === ID_JURIDICA) tipo = "JURIDICA";
                else {
                    const n = norm(txt);
                    if (n.includes("FISICA")) tipo = "FISICA";
                    else if (n.includes("JURIDICA")) tipo = "JURIDICA";
                }

                if (tipo === "FISICA") {
                    const d = raw.slice(0, 9);
                    ident.value = applyBlocks(d, blocks("1-4-4"));
                } else if (tipo === "JURIDICA") {
                    const d = raw.slice(0, 10);
                    ident.value = applyBlocks(d, blocks("1-3-6"));
                } else {
                    ident.value = raw; // sin tipo => sin formato
                }
            }

            function formatPhoneView() {
                if (!tel) return;
                const d = digits(tel.value).slice(0, 8);
                tel.value = d.length > 4 ? d.slice(0, 4) + "-" + d.slice(4) : d;
            }

            if (ddl) ddl.addEventListener("change", formatIdentView);
            if (ident) {
                ident.setAttribute("inputmode", "numeric");
                ident.setAttribute("autocomplete", "off");
                ident.addEventListener("input", formatIdentView);
            }
            if (tel) {
                tel.setAttribute("inputmode", "numeric");
                tel.setAttribute("autocomplete", "off");
                tel.addEventListener("input", formatPhoneView);
            }

            formatIdentView();
            formatPhoneView();

            const forms = document.getElementsByTagName("form");
            Array.from(forms).forEach(f => {
                f.addEventListener("submit", function () {
                    if (ident) ident.value = digits(ident.value); // ej: 123456789 / 3101123456
                    if (tel) tel.value = digits(tel.value);   // ej: 88888888
                });
            });
        });
    </script>
}
