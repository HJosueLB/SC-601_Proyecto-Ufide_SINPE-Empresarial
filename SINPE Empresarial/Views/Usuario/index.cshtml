@model IEnumerable<SINPE_Empresarial.Domain.UsuarioDomain.Entities.Usuario>

@{
    ViewBag.Title = "Lista de Usuarios";
}

<div class="container mt-4">
    <h2 class="text-primary mb-4">Usuarios Registrados</h2>

    <div class="fixed-table-toolbar d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">
        <!-- Botón para agregar usuario -->
        <a href="@Url.Action("Crear", "Usuario")"
           class="btn text-white fw-bold"
           style="background-color: #574FD6;">
            <i class="bi bi-plus-circle"></i> Registrar Usuario
        </a>
    </div>

    <table class="table table-striped table-bordered">
        <thead class="thead-dark">
            <tr>
                <th>Nombres</th>
                <th>Primer Apellido</th>
                <th>Segundo Apellido</th>
                <th>Identificación</th>
                <th>Correo Electrónico</th>
                <th>Fecha de Registro</th>
                <th>Fecha de Modificación</th>
                <th>Estado</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var usuario in Model)
            {
                <tr>
                    <td>@usuario.Nombres</td>
                    <td>@usuario.PrimerApellido</td>
                    <td>@usuario.SegundoApellido</td>
                    <td>@usuario.Identificacion</td>
                    <td>@usuario.CorreoElectronico</td>
                    <td>@usuario.FechaDeRegistro.ToString("dd/MM/yyyy hh:mm:ss tt")</td>
                    <td>@(usuario.FechaDeModificacion?.ToString("dd/MM/yyyy hh:mm:ss tt") ?? "N/A")</td>
                    <td>@(usuario.Estado ? "Activo" : "Inactivo")</td>
                    <td>
                        @Html.ActionLink("Editar", "Editar", new { id = usuario.IdUsuario }, new { @class = "btn btn-sm btn-primary" })
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
