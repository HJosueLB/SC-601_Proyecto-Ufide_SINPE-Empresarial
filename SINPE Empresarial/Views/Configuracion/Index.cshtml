@model IEnumerable<SINPE_Empresarial.Services.Configuracion.DTOs.ConfiguracionListadoDto>

@{
    ViewBag.Title = "Lista de Configuraciones";
}

<main>

    <!-- Título de la página -->
    <h1 class="mb-4"> Configuraciones </h1>

    <!-- Barra de opciones -->
    <div class="fixed-table-toolbar d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">
        <!-- Botón para agregar configuración -->
        <a href="@Url.Action("Agregar", "Configuracion")"
           class="btn text-white fw-bold"
           style="background-color: #574FD6;">
            <i class="bi bi-plus-circle"></i> Agregar Configuración
        </a>

    </div>

    <!-- Tabla de configuraciones -->
    <div class="table-responsive mb-5">
        <table class="table table-hover align-middle">
            <!-- Encabezado -->
            <thead class="table-light">
                <tr>
                    <th>Acciones</th>
                    <th>Comercio</th>
                    <th>Tipo Configuración</th>
                    <th>Comisión (%)</th>
                    <th>Fecha Registro</th>
                    <th>Fecha Modificación</th>
                    <th>Estado</th>
                </tr>
            </thead>

            <!-- Registros -->
            <tbody class="table-group-divider">
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            <a href="@Url.Action("Editar", "Configuracion", new { id = item.IdConfiguracion })"
                               class="btn btn-sm btn-success">
                                <i class="bi bi-pencil-square"></i>
                            </a>
                        </td>
                        <td>@item.NombreComercio</td>
                        <td>@item.TipoConfiguracion</td>
                        <td>@item.Comision</td>
                        <td>@item.FechaDeRegistro</td>
                        <td>@item.FechaDeModificacion</td>
                        <td>@item.Estado</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

</main>
