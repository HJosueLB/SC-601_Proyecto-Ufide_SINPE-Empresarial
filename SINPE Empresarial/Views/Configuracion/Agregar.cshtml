@model SINPE_Empresarial.Domain.ConfiguracionDomain.Entities.Configuracion

@{
    ViewBag.Title = "Registrar Configuración";
}

<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
            <h4 class="mb-0">Registrar Configuración</h4>
        </div>

        <div class="card-body">
            @using (Html.BeginForm("Agregar", "Configuracion", FormMethod.Post))
            {
                @Html.AntiForgeryToken()

                <div class="mb-3">
                    @Html.LabelFor(model => model.IdComercio, "Comercio", htmlAttributes: new { @class = "form-label fw-bold" })
                    @Html.DropDownListFor(model => model.IdComercio, (SelectList)ViewBag.ListaComercios, "Seleccione un comercio", new { @class = "form-select" })
                    @Html.ValidationMessageFor(model => model.IdComercio, "", new { @class = "text-danger" })
                </div>

                <div class="mb-3">
                    @Html.LabelFor(model => model.TipoConfiguracion, "Tipo de Configuración", htmlAttributes: new { @class = "form-label fw-bold" })
                    @Html.DropDownListFor(model => model.TipoConfiguracion, new SelectList(
                        new[]{
                            new { Value = "1", Text = "Plataforma" },
                            new { Value = "2", Text = "Externa" },
                            new { Value = "3", Text = "Ambas" }
                        }, "Value", "Text"), "Seleccione", new { @class = "form-select" })
                    @Html.ValidationMessageFor(model => model.TipoConfiguracion, "", new { @class = "text-danger" })
                </div>

                <div class="mb-3">
                    @Html.LabelFor(model => model.Comision, htmlAttributes: new { @class = "form-label fw-bold" })
                    @Html.TextBoxFor(model => model.Comision, new { @class = "form-control", type = "number", min = "0" })
                    @Html.ValidationMessageFor(model => model.Comision, "", new { @class = "text-danger" })
                </div>

                <div class="mb-3">
                    <b>@Html.ValidationSummary(true, "", new { @class = "text-danger mb-3" })</b>
                </div>

                    <div class="d-flex justify-content-end">
                        <button type="submit" class="btn btn-primary me-2">Guardar</button>
                        <a href="@Url.Action("Index", "Configuracion")" class="btn btn-outline-secondary">Cancelar</a>
                    </div>
                    }
                </div>
            </div>
</div>
